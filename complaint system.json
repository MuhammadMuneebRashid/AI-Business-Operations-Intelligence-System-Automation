      "parameters": {
        "jsCode": "const fields=$input.first().json.body.data.fields;\nconst f1=fields.find(f=>f.label===\"Customer Name:\");\nconst name=f1.value;\nconst f2=fields.find(f=>f.label===\"Customer Email:\");\nconst email=f2.value;\nconst f3=fields.find(f=>f.label===\"Order Id:\");\nconst order_id=f3.value;\nconst f4=fields.find(f=>f.label===\"Complaint Category:\");\nconst value=f4.value[0];\nconst options=f4.options.find(o=>o.id===value)\nconst category=options.text;\nconst f5=fields.find(f=>f.label===\"Complaint Description:\");\nconst description=f5.value;\nconst f6=fields.find(f=>f.label===\"Complaint Date:\");\nconst complaint_date=f6.value;\n\n\nreturn[{\n  name,\n  email,\n  order_id,\n  category,\n  description,\n  complaint_date\n}]"
      },
