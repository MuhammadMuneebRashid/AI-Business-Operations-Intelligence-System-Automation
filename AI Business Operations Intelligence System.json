    {
      "parameters": {
        "jsCode": "const pendingReports = items.filter(item => {\n  const status = String(item.json.status || '').trim().toLowerCase();\n\n  return status === '' || status === 'pending';\n});\n\nconst reports = pendingReports.map(item => ({\n  row_number: item.json.row_number,\n  business_name: item.json.business_name,\n  report_date: item.json.report_date,\n  total_revenue: item.json.total_revenue,\n  total_orders: item.json.total_order,\n  total_expenses: item.json.total_expense,\n  pending_orders: item.json.pending_orders\n}));\n\nreturn [\n  {\n    json: {\n      business_reports: reports,\n      report_count: reports.length\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        -80
      ],
      "id": "4c518185-56d6-4eb2-b9fd-b761aba5c79f",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const pendingComplaints = items.filter(item => {\n  const status = String(item.json.status || '').trim().toLowerCase();\n\n  return status === '' || status === 'pending';\n});\n\nconst complaints = pendingComplaints.map(item => ({\n  row_number: item.json.row_number,\n  customer_name: item.json.name,\n  customer_email: item.json.email,\n  order_id: item.json.order_id,\n  category: item.json.category,\n  description: item.json.description,\n  complaint_date: item.json.complaint_date\n}));\n\nreturn [\n  {\n    json: {\n      customer_complaints: complaints,\n      complaint_count: complaints.length\n    }\n  }\n];"
      },
